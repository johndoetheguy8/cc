import sys

from PySide6.QtCore import Qt, QSize
from PySide6.QtGui import QPainter, QPen, QColor, QFont
from PySide6.QtWidgets import (
    QApplication,
    QWidget,
    QVBoxLayout,
    QLabel,
    QPushButton,
)


GREEN = "#69e995"
BG = "#050605"
PANEL = "#080b09"


class DownloadIcon(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(QSize(20, 20))

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)

        pen = QPen(QColor(GREEN))
        pen.setWidthF(1.8)
        pen.setCapStyle(Qt.RoundCap)
        pen.setJoinStyle(Qt.RoundJoin)

        painter.setPen(pen)
        painter.setBrush(Qt.NoBrush)

        painter.drawLine(10, 2, 10, 13)
        painter.drawLine(5.5, 9, 10, 13.5)
        painter.drawLine(14.5, 9, 10, 13.5)
        painter.drawLine(4, 18, 16, 18)

        painter.end()


class GhostApp(QWidget):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("ghost.cc")
        self.setFixedSize(560, 330)

        self.setStyleSheet(f"""
            QWidget {{
                background: {BG};
                color: white;
                font-family: Arial;
            }}
        """)

        root = QVBoxLayout(self)
        root.setContentsMargins(40, 35, 40, 35)
        root.setSpacing(0)

        title = QLabel("The Client You Will")
        title.setAlignment(Qt.AlignCenter)
        title.setStyleSheet("""
            QLabel {
                color: white;
                font-family: Georgia;
                font-size: 46px;
                font-weight: 400;
            }
        """)

        subtitle = QLabel("Never Lose With")
        subtitle.setAlignment(Qt.AlignCenter)
        subtitle.setStyleSheet(f"""
            QLabel {{
                color: {GREEN};
                font-family: Georgia;
                font-size: 46px;
                font-weight: 400;
                margin-top: 2px;
            }}
        """)

        button = QPushButton()
        button.setFixedHeight(52)
        button.setCursor(Qt.PointingHandCursor)

        button_layout = QVBoxLayout(button)
        button_layout.setContentsMargins(0, 0, 0, 0)

        icon = DownloadIcon()

        text = QLabel("Download")
        text.setStyleSheet(f"""
            QLabel {{
                color: {GREEN};
                font-family: Arial;
                font-size: 16px;
                font-weight: 500;
            }}
        """)

        button_row = QVBoxLayout()
        button_row.setAlignment(Qt.AlignCenter)
        button_row.setSpacing(8)

        from PySide6.QtWidgets import QHBoxLayout

        row = QHBoxLayout()
        row.setAlignment(Qt.AlignCenter)
        row.setSpacing(10)
        row.addWidget(icon)
        row.addWidget(text)

        button_layout.addLayout(row)

        button.setStyleSheet(f"""
            QPushButton {{
                background: {PANEL};
                border: 1px solid rgba(105, 233, 149, 0.38);
                border-radius: 10px;
            }}

            QPushButton:hover {{
                background: #0b100d;
                border: 1px solid rgba(105, 233, 149, 0.70);
            }}

            QPushButton:pressed {{
                background: #070907;
                border: 1px solid rgba(105, 233, 149, 0.55);
            }}
        """)

        # Currently intentionally does nothing.
        button.clicked.connect(lambda: None)

        root.addStretch()
        root.addWidget(title)
        root.addWidget(subtitle)

        root.addSpacing(32)

        root.addWidget(
            button,
            alignment=Qt.AlignHCenter
        )

        root.addStretch()


if __name__ == "__main__":
    app = QApplication(sys.argv)

    app.setStyle("Fusion")

    window = GhostApp()
    window.show()

    sys.exit(app.exec())
